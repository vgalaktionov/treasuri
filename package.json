{
  "name": "treasuri",
  "version": "0.2.0",
  "private": true,
  "description": "Private personal-finance PWA",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check": "npm run typecheck && biome check . && vitest run",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "prepare": "husky",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.60.0",
    "@testcontainers/postgresql": "^12.0.1",
    "@types/node": "^22.19.19",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.7",
    "husky": "^9.1.7",
    "testcontainers": "^12.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "pg": "^8.21.0"
  }
}
