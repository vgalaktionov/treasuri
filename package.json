{
  "name": "treasuri",
  "version": "0.2.0",
  "private": true,
  "description": "Private personal-finance PWA",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "admin": "tsx src/server/admin.ts",
    "build": "npm run typecheck && npm run build:client",
    "build:client": "vite build",
    "check": "npm run typecheck && biome check . && vitest run",
    "dev": "npm run build:client && tsx src/server/index.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "migrate": "tsx src/server/migrate.ts",
    "prepare": "husky",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/server/worker.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testcontainers/postgresql": "^12.0.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.19.19",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "husky": "^9.1.7",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.0",
    "testcontainers": "^12.0.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "lucide-react": "^1.17.0",
    "openid-client": "^6.8.4",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sql-template-tag": "^5.2.1",
    "zod": "^4.4.3"
  }
}
